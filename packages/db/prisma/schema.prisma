generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique @db.VarChar(255)
  passwordHash String
  role         String    @default("Candidate")
  tier         String    @default("Free")
  avatar       String?
  createdAt    DateTime  @default(now())

  sessions     Session[]
  resumes      Resume[]

  @@map("users")
}

model Session {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Resume {
  id         Int      @id @default(autoincrement())
  userId     Int
  fileName   String
  targetRole String?
  atsScore   Int
  tier       String
  summary    String
  analysis   Json
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

