{
  "name": "cv-lens",
  "private": true,
  "packageManager": "bun@1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --filter web dev",
    "lint": "bun --filter web lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "postgres": "^3.4.9"
  }
}